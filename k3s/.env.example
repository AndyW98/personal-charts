# Copy to .env (gitignored) and edit. One .env per host.

# server = control-plane node, agent = worker node
K3S_ROLE=server

# Shared cluster secret, identical on every node. Generate with: openssl rand -hex 32
K3S_TOKEN=

# Agents (and extra servers) only: API endpoint of an existing server.
# Leave empty on the first server.
K3S_URL=
# K3S_URL=https://192.168.1.10:6443

# Optional overrides
# K3S_VERSION=v1.31.14-k3s1
# K3S_NODE_NAME=
# K3S_EXTRA_ARGS=--disable=traefik
# K3S_KUBECONFIG_MODE=600
